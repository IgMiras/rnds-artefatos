  <publisher value="Ministério da Saúde do Brasil" />
  <description value="O registro de atendimento clínico é o registro de dados essenciais de uma consulta realizada a um indivíduo no âmbito da atenção básica, especializada ou domiciliar (atendimento diário). Apresenta informações relacionadas ao acompanhamento do indivíduo como medições, diagnósticos e/ou problemas avaliados, exames, procedimentos, pequenas cirurgias e desfecho. (Resolução CIT Nº 33, de 22 de março de 2018)" />
  <fhirVersion value="4.0.1" />
  <kind value="resource" />
  <abstract value="false" />
